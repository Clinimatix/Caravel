# Clinimatix Caravel environment sample (M0 does not connect to a database)
# Copy this file to ".env" and customize values for your environment.

# ASP.NET Core environment
# Set ASPNETCORE_ENVIRONMENT before creating the host, not in .env.
APP_NAME="Clinimatix Caravel App"

# Database connection string (pick one and uncomment)
# Windows LocalDB (developer machines)
# ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=caravel_dev;Trusted_Connection=True;TrustServerCertificate=True

# SQL Server Express with integrated auth
# ConnectionStrings__DefaultConnection=Server=.\SQLEXPRESS;Database=caravel_dev;Trusted_Connection=True;TrustServerCertificate=True

# SQL Server with user credentials
# ConnectionStrings__DefaultConnection=Server=localhost;Database=caravel_dev;User Id=myuser;Password=your_password;TrustServerCertificate=True
